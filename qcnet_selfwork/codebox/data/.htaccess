# Deny all direct web access to stored project data.
# api.php/cleanup.php read and write these files server-side — nothing
# in here should ever be reachable directly by URL.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
